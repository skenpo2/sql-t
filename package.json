{
  "name": "express-postgres-crud",
  "version": "1.0.0",
  "description": "Express + PostgreSQL CRUD API in TypeScript using the pg driver (no ORM)",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:setup": "psql \"$(grep -E '^DATABASE_URL' .env | cut -d= -f2- | tr -d ' ')\" -f sql/schema.sql"
  },
  "keywords": ["express", "postgres", "pg", "typescript", "crud"],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
